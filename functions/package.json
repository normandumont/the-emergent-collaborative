{
  "name": "meridian-station-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm --prefix ../rag run build:runtime && tsc",
    "gcp-build": "tsc",
    "test:rag:live": "npm run build && node scripts/test-rag.mjs --live",
    "rag:manifest:check": "npm run build && node scripts/validate-manifest.mjs",
    "test:rag:preview": "npm run build && node scripts/preview-rag.mjs",
    "test:rag:grounding": "npm run build && node scripts/grounding-capture.mjs",
    "test:grounding-capture": "npm run build && node --test tests/grounding-capture.test.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "emulator": "npm run build && node scripts/emulator.mjs",
    "test:emulator": "npm run build && node scripts/emulator.mjs --smoke"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.0.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "firebase-tools": "^15.0.0",
    "typescript": "~5.9.3"
  }
}
