---
import SiteLayout from "../layouts/SiteLayout.astro";
import AskParkinsons from "../components/AskParkinsons.astro";
import DevicePreview from "../components/DevicePreview.astro";
import { headline, secondaryNavigation } from "../content/site";
---

<SiteLayout title="Parkinson's research and technology" wide>
  <div class="home-layout">
    <aside class="explore-panel" aria-labelledby="story-nav-title">
      <details class="story-nav" open>
        <summary title="Explore Meridian Station">
          <h2 id="story-nav-title">
            <span class="panel-title">Explore Meridian Station</span>
            <span class="panel-toggle" aria-hidden="true"></span>
          </h2>
        </summary>
        <div class="panel-content">
          <p class="section-kicker">The work behind the products</p>
          <nav aria-label="Explore Meridian Station">
            {
              secondaryNavigation.map(({ label, href }) => (
                <a href={href}>
                  <span>{label}</span>
                  <span aria-hidden="true">→</span>
                </a>
              ))
            }
          </nav>
        </div>
      </details>
    </aside>
    <div class="home-content">
      <section id="introduction" class="hero" aria-labelledby="home-title">
        <div class="hero-inner">
          <p class="hero-kicker">Parkinson's research and technology</p>
          <h1 id="home-title">{headline}</h1>
          <p class="hero-copy">
            Meridian Station explores AI-assisted Parkinson's research and new
            ways to understand responsibly selected observations over time.
          </p>
        </div>
      </section>

      <div id="knowledgebase">
        <AskParkinsons />
      </div>

      <section class="mobile-product" aria-labelledby="mobile-title">
        <div class="mobile-copy">
          <p class="section-kicker green-kicker">
            Mobile application · In development
          </p>
          <h2 id="mobile-title">Understanding change over time.</h2>
          <p>
            Meridian Station is developing a mobile application to explore
            responsibly selected observations such as movement, exercise,
            symptoms, sleep, and environment over time.
          </p>
          <p class="product-caveat">
            An exploratory technology project—not a diagnostic or clinical
            product.
          </p>
          <a class="text-link" href="/mobile/">
            Explore the mobile project <span aria-hidden="true">→</span>
          </a>
        </div>
        <DevicePreview />
      </section>
    </div>
  </div>
</SiteLayout>
