---
import Masthead from "../components/Masthead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { definition, siteName } from "../content/site";
import interFont from "../assets/fonts/Inter-Latin-Variable.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = `${definition} Developing a direction for AI-assisted research and longitudinal understanding; not a clinical service.`,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="preload"
      href={interFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} | {siteName}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Masthead />
    <main
      id="main-content"
      class={wide ? "landing-main" : "shell utility-main"}
      tabindex="-1"
    >
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
