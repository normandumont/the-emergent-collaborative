---
import { approvedCopy, siteName } from "../content/site";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <a class="footer-name" href="/">{siteName}</a>
      <nav aria-label="Footer navigation">
        <a href="/about/#collaborate">Contact</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </div>
    <div class="footer-meta">
      <p>
        Educational information only. Meridian Station does not diagnose
        conditions, recommend treatment, or replace professional medical care.
      </p>
      <div>
        <p>{approvedCopy.publicationResponsibility}</p>
        <p>
          Public content last reviewed:
          <time datetime="2026-10-31">October 31, 2026</time>
        </p>
      </div>
    </div>
  </div>
</footer>
