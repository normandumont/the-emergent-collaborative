<figure class="device-preview">
  <div
    class="device-wrap"
    role="img"
    aria-label="Conceptual mobile application showing illustrative observation bars and movement, exercise and sleep labels. Not recorded health data."
  >
    <div class="device" aria-hidden="true">
      <div class="device-speaker"></div>
      <div class="device-screen">
        <div class="device-header">
          <span>Today</span>
          <span class="device-dot"></span>
        </div>
        <div class="device-copy">
          <span>Daily observations</span>
          <strong>Notice change,<br />not just moments.</strong>
        </div>
        <div class="signal">
          {Array.from({ length: 12 }, () => <span />)}
        </div>
        <div class="device-rows">
          <div><span>Movement</span><i></i></div>
          <div><span>Exercise</span><i></i></div>
          <div><span>Sleep</span><i></i></div>
        </div>
      </div>
    </div>
    <div class="device-orbit" aria-hidden="true"></div>
  </div>
  <figcaption>Concept illustration · Not recorded health data</figcaption>
</figure>
